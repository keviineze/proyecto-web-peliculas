@startuml
title Calificación de contenidos vistos

|Sistema|
start
:Recuperar array de contenidos marcados como "vistos" desde localStorage;
if (¿Hay contenidos vistos pendientes de calificar?) then (sí)
  
  while (¿Quedan contenidos sin calificar en el array?) is (sí)
    :Obtener el siguiente contenido del array;
    :Mostrar prompt() solicitando calificación (1 a 5) para el contenido actual;
    |Usuario|
    :Ingresar la calificación o cancelar;
    |Sistema|
    if (¿Se canceló la calificación?) then (sí)
      :Mostrar alert() de "Proceso interrumpido";
      stop
    else (no)
      :Validar que la calificación sea un número entero de 1 a 5;
      while (¿La calificación es inválida?) is (sí)
        :Mostrar alert() indicando el rango permitido (1 a 5);
        :Mostrar prompt() para ingresar nuevamente la calificación;
        |Usuario|
        :Ingresar una calificación corregida;
        |Sistema|
        :Validar nuevamente la calificación;
      endwhile (no)
      :Guardar la calificación asociada al contenido actual;
      :Persistir el estado actualizado en localStorage;
      :Mostrar alert() confirmando la calificación guardada para este contenido;
    endif
  endwhile (no)
  :Mostrar alert() de "Todos los contenidos vistos han sido calificados";
else (no)
  :Mostrar alert() indicando "No hay contenidos vistos pendientes de calificación";
endif
stop
@enduml