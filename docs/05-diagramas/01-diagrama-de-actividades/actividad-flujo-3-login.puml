@startuml
title Autenticación (Login) simulada

|Sistema|
start
:Mostrar prompt() para ingresar el correo;
|Usuario|
:Ingresar el correo o cancelar;
|Sistema|
if (¿Se canceló el ingreso?) then (sí)
  :Mostrar alert() de cancelación;
  stop
else (no)
endif

:Mostrar prompt() para ingresar la contraseña;
|Usuario|
:Ingresar la contraseña o cancelar;
|Sistema|
if (¿Se canceló el ingreso?) then (sí)
  :Mostrar alert() de cancelación;
  stop
else (no)
endif

:Validar los campos y comparar con las credenciales de demostración locales;
if (¿Las credenciales son válidas?) then (sí)
  :Mostrar alert() de inicio de sesión de demostración exitoso;
else (no)
  :Mostrar alert() de credenciales inválidas;
  :Mostrar prompt() para elegir si desea volver a intentar;
  |Usuario|
  :Elegir si desea volver a intentar;
  |Sistema|
  while (¿Desea volver a intentar?) is (sí)
    :Mostrar prompt() para ingresar el correo;
    |Usuario|
    :Ingresar el correo o cancelar;
    |Sistema|
    if (¿Se canceló el ingreso?) then (sí)
      :Mostrar alert() de cancelación;
      stop
    else (no)
    endif
    :Mostrar prompt() para ingresar la contraseña;
    |Usuario|
    :Ingresar la contraseña o cancelar;
    |Sistema|
    if (¿Se canceló el ingreso?) then (sí)
      :Mostrar alert() de cancelación;
      stop
    else (no)
    endif
    :Validar los campos y comparar con las credenciales de demostración locales;
    if (¿Las credenciales son válidas?) then (sí)
      :Mostrar alert() de inicio de sesión de demostración exitoso;
      break
    else (no)
      :Mostrar alert() de credenciales inválidas;
      :Mostrar prompt() para elegir si desea volver a intentar;
      |Usuario|
      :Elegir si desea volver a intentar;
      |Sistema|
    endif
  endwhile (no)
endif
:Finalizar la simulación sin conexión a un servidor;
stop
@enduml