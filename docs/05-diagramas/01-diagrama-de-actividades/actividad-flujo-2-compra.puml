@startuml
title Simulación de compra de entradas

|Sistema|
start
:Mostrar prompt() para elegir una película;
|Usuario|
:Ingresar el título de la película;
|Sistema|
:Buscar la película en el catálogo;
if (¿La película existe?) then (sí)
  :Mostrar prompt() para ingresar la cantidad de entradas;
  |Usuario|
  :Ingresar la cantidad de entradas;
  |Sistema|
  :Validar que la cantidad sea un número entre 1 y 10;
  while (¿La cantidad es inválida?) is (sí)
    :Mostrar alert() con el error de cantidad;
    :Mostrar prompt() para ingresar nuevamente la cantidad;
    |Usuario|
    :Ingresar una cantidad corregida;
    |Sistema|
    :Validar nuevamente la cantidad;
  endwhile (no)
  :Calcular el importe total de la simulación;
  :Mostrar el importe mediante alert();
  :Mostrar prompt() para confirmar la simulación;
  |Usuario|
  :Confirmar o cancelar la simulación;
  |Sistema|
  if (¿Confirma la simulación?) then (sí)
    :Mostrar alert() con el resumen de entradas simuladas;
    :Indicar que no se realizó un pago real;
  else (no)
    :Mostrar alert() de operación cancelada;
  endif
else (no)
  :Mostrar alert() indicando que la película no existe;
endif
stop
@enduml